# Copy to .env and edit; variables already set in the environment take precedence.
# Models and datasets: <PACT_RESOURCE>/models/<name>, <PACT_RESOURCE>/datasets/{train,test,provenance}
PACT_RESOURCE=./resource
# Run directories: <PACT_ARTIFACTS>/<model>/<method>/seed-<n>
PACT_ARTIFACTS=./artifacts
# SimpleQA judge (default: <PACT_RESOURCE>/models/Llama-3.1-8B-Instruct)
PACT_JUDGE_MODEL=
# Hugging Face cache and token (Llama 3.1 is gated)
HF_HOME=
HF_TOKEN=
